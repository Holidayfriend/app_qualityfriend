  locale           String                      @db.VarChar(8)
  salutation       String                      @default("") @db.VarChar(20)
  firstName        String                      @map("first_name") @db.VarChar(120)
  lastName         String                      @map("last_name") @db.VarChar(120)
  email            String                      @default("") @db.VarChar(320)
  phone            String                      @default("") @db.VarChar(40)
  message          String                      @default("") @db.Text
  cvFileName       String                      @default("") @map("cv_file_name") @db.VarChar(255)
  keepForOtherJobs Boolean                     @default(false) @map("keep_for_other_jobs")
  answers          Json
  notes            Json                        @default("{}")
  aiStatus         String                      @default("PENDING") @map("ai_status") @db.VarChar(20)
  aiError          String?                     @map("ai_error") @db.Text
  aiScore          Int?                        @map("ai_score")
  aiRecommendation String?                     @map("ai_recommendation") @db.VarChar(40)
  aiSocial         Int?                        @map("ai_social")
  aiProfessional   Int?                        @map("ai_professional")
  aiMethodical     Int?                        @map("ai_methodical")
  aiPersonal       Int?                        @map("ai_personal")
  aiSummaryEn      String                      @default("") @map("ai_summary_en") @db.Text
  aiSummaryDe      String                      @default("") @map("ai_summary_de") @db.Text
  aiSummaryIt      String                      @default("") @map("ai_summary_it") @db.Text
  aiScoredAt       DateTime?                   @map("ai_scored_at") @db.Timestamptz(3)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant      HotelTenant                 @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  job              RecruitingJob               @relation(fields: [hotelTenantId, jobId], references: [hotelTenantId, id], onDelete: Cascade, onUpdate: Cascade)
  employee         RecruitingEmployee?
  files            RecruitingApplicationFile[]

  @@unique([hotelTenantId, id])
  @@index([hotelTenantId, jobId])
  @@index([hotelTenantId, createdAt])
  @@map("recruiting_applications")
}

