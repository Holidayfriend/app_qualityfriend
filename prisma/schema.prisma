// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Step one: XML/stay foundation. Import matching must be verified against source XML.

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ReservationStatus {
  UNKNOWN
  RESERVED
  OCCUPIED
  DEPARTED
  CANCELLED
  NO_SHOW
}

enum RoomCleanliness {
  UNKNOWN
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

model Floor {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  code String @db.VarChar(40)
  nameEn String @map("name_en") @db.VarChar(180)
  nameDe String? @map("name_de") @db.VarChar(180)
  nameIt String? @map("name_it") @db.VarChar(180)
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomRecords Room[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, code])

  @@map("floors")
}

model RoomCategory {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  nameEn String @map("name_en") @db.VarChar(180)
  nameDe String? @map("name_de") @db.VarChar(180)
  nameIt String? @map("name_it") @db.VarChar(180)
  expressMinutes Int? @map("express_minutes")
  normalMinutes Int? @map("normal_minutes")
  departureMinutes Int? @map("departure_minutes")
  finalMinutes Int? @map("final_minutes")
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomRecords Room[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, nameEn])

  @@map("room_categories")
}

model Room {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  number String @db.VarChar(40)
  nameEn String? @map("name_en") @db.VarChar(180)
  nameDe String? @map("name_de") @db.VarChar(180)
  nameIt String? @map("name_it") @db.VarChar(180)
  floorId String? @map("floor_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  floor Floor? @relation(fields: [hotelTenantId, floorId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  category RoomCategory? @relation(fields: [hotelTenantId, categoryId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationRoomStayRecords ReservationRoomStay[]
  roomOperationalStateRecords RoomOperationalState[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, number])
  @@index([hotelTenantId, floorId])
  @@index([hotelTenantId, categoryId])
  @@map("rooms")
}

model HotelImportSource {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  provider String @default("ASA_XML") @db.VarChar(80)
  sourceKey String @map("source_key") @db.VarChar(180)
  lastSuccessfulAt DateTime? @map("last_successful_at") @db.Timestamptz(3)
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  importRunRecords ImportRun[]
  reservationRecords Reservation[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, provider, sourceKey])

  @@map("hotel_import_sources")
}

model ImportRun {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  status ImportRunStatus @default(RUNNING)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  checksum String? @db.VarChar(64)
  recordsRead Int @default(0) @map("records_read")
  recordsCreated Int @default(0) @map("records_created")
  recordsUpdated Int @default(0) @map("records_updated")
  recordsRejected Int @default(0) @map("records_rejected")
  errorSummary String? @map("error_summary") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source HotelImportSource @relation(fields: [hotelTenantId, sourceId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@index([hotelTenantId, sourceId, startedAt])
  @@map("import_runs")
}

model Reservation {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  sourceId String? @map("source_id") @db.Uuid
  externalId String? @map("external_id") @db.VarChar(255)
  sourceStatus String? @map("source_status") @db.VarChar(80)
  status ReservationStatus @default(UNKNOWN)
  bookingGroup String? @map("booking_group") @db.VarChar(255)
  offer String? @db.Text
  board String? @db.VarChar(120)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source HotelImportSource? @relation(fields: [hotelTenantId, sourceId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationRoomStayRecords ReservationRoomStay[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, sourceId, externalId])
  @@index([hotelTenantId, status])
  @@map("reservations")
}

model ReservationRoomStay {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  sourceSegmentId String? @map("source_segment_id") @db.VarChar(255)
  arrivalDate DateTime @map("arrival_date") @db.Date
  departureDate DateTime @map("departure_date") @db.Date
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt DateTime? @map("checked_out_at") @db.Timestamptz(3)
  sourceStatus String? @map("source_status") @db.VarChar(80)
  adultCount Int? @map("adult_count")
  childCount Int? @map("child_count")
  childK1Count Int? @map("child_k1_count")
  childK2Count Int? @map("child_k2_count")
  childK3Count Int? @map("child_k3_count")
  serviceRemarks String? @map("service_remarks") @db.Text
  sourceFromRoomNumber String? @map("source_from_room_number") @db.VarChar(40)
  sourceToRoomNumber String? @map("source_to_room_number") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation Reservation @relation(fields: [hotelTenantId, reservationId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationGuestRecords ReservationGuest[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, reservationId, sourceSegmentId])
  @@index([hotelTenantId, arrivalDate])
  @@index([hotelTenantId, departureDate])
  @@index([hotelTenantId, roomId, arrivalDate])
  @@map("reservation_room_stays")
}

model ReservationGuest {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomStayId String @map("room_stay_id") @db.Uuid
  sourceGuestId String? @map("source_guest_id") @db.VarChar(255)
  name String @db.VarChar(255)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  language String? @db.VarChar(40)
  vip Boolean?
  previousStayCount Int? @map("previous_stay_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomStay ReservationRoomStay @relation(fields: [hotelTenantId, roomStayId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, roomStayId, sourceGuestId])

  @@map("reservation_guests")
}

model RoomOperationalState {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  cleanliness RoomCleanliness @default(UNKNOWN)
  doNotDisturb Boolean @default(false) @map("do_not_disturb")
  noService Boolean @default(false) @map("no_service")
  doNotDisturbUntil DateTime? @map("do_not_disturb_until") @db.Timestamptz(3)
  noServiceUntil DateTime? @map("no_service_until") @db.Timestamptz(3)
  isExpress Boolean @default(false) @map("is_express")
  expressDeadline DateTime? @map("express_deadline") @db.Timestamptz(3)
  lastCleanedAt DateTime? @map("last_cleaned_at") @db.Timestamptz(3)
  lastInspectedAt DateTime? @map("last_inspected_at") @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, roomId])
  @@index([hotelTenantId, cleanliness])
  @@map("room_operational_states")
}


model SuperAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("super_admins")
}

enum HotelLanguage {
  EN
  DE
  IT
}

enum UserRole {
  EMPLOYEE
  TEAM_LEAD
  MANAGEMENT
  ADMIN
}

enum PermissionScope {
  OWN
  DEPARTMENT
  ALL
}

enum SubscriptionStatus {
  PENDING
  APPROVAL_PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  COMPED
}

enum PaymentProvider {
  PAYPAL
}

model HotelTenant {
  // Configure before resolving hotel-local operational dates; no guessed default.
  timeZone String? @map("time_zone") @db.VarChar(80)
  floorRecords Floor[]
  roomCategoryRecords RoomCategory[]
  roomRecords Room[]
  hotelImportSourceRecords HotelImportSource[]
  importRunRecords ImportRun[]
  reservationRecords Reservation[]
  reservationRoomStayRecords ReservationRoomStay[]
  reservationGuestRecords ReservationGuest[]
  roomOperationalStateRecords RoomOperationalState[]
  id                           String                 @id @default(uuid()) @db.Uuid
  hotelNameEn                  String                 @map("hotel_name_en") @db.VarChar(180)
  hotelNameDe                  String                 @map("hotel_name_de") @db.VarChar(180)
  hotelNameIt                  String                 @map("hotel_name_it") @db.VarChar(180)
  email                        String                 @db.VarChar(320)
  logoUrl                      String?                @map("logo_url") @db.VarChar(2048)
  hotelLanguage                HotelLanguage          @default(EN) @map("hotel_language")
  isActive                     Boolean                @default(true) @map("is_active")
  dataProtectionEn             String?                @map("data_protection_en") @db.Text
  dataProtectionDe             String?                @map("data_protection_de") @db.Text
  dataProtectionIt             String?                @map("data_protection_it") @db.Text
  privacyPolicyEn              String?                @map("privacy_policy_en") @db.Text
  privacyPolicyDe              String?                @map("privacy_policy_de") @db.Text
  privacyPolicyIt              String?                @map("privacy_policy_it") @db.Text
  companyName                  String                 @map("company_name") @db.VarChar(180)
  streetAddress                String                 @map("street_address") @db.VarChar(255)
  postalCode                   String                 @map("postal_code") @db.VarChar(32)
  city                         String                 @db.VarChar(120)
  country                      String                 @db.VarChar(120)
  contactPerson                String                 @map("contact_person") @db.VarChar(180)
  phoneNumber                  String?                @map("phone_number") @db.VarChar(40)
  vatId                        String?                @map("vat_id") @db.VarChar(64)
  tripadvisorId                String?                @map("tripadvisor_id") @db.VarChar(120)
  activeMcp                    Boolean                @default(false) @map("active_mcp")
  mcpHotelId                   String?                @map("mcp_hotel_id") @db.VarChar(128)
  mcpUserEmail                 String?                @map("mcp_user_email") @db.VarChar(320)
  mcpUserPassword              String?                @map("mcp_user_password") @db.VarChar(255)
  mcpUserDepartment            String?                @map("mcp_user_department") @db.VarChar(128)
  subscriptionStatus           SubscriptionStatus     @default(PENDING) @map("subscription_status")
  paypalSubscriptionId         String?                @unique @map("paypal_subscription_id") @db.VarChar(128)
  paypalPlanId                 String?                @map("paypal_plan_id") @db.VarChar(128)
  subscriptionStartedAt        DateTime?              @map("subscription_started_at") @db.Timestamptz(3)
  subscriptionCurrentPeriodEnd DateTime?              @map("subscription_current_period_end") @db.Timestamptz(3)
  subscriptionCancelledAt      DateTime?              @map("subscription_cancelled_at") @db.Timestamptz(3)
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                        User[]
  departments                  Department[]
  teams                        Team[]
  auditLogs                    AuditLog[]
  rolePermissions              RoleModulePermission[]
  subscriptions                Subscription[]
  paymentEvents                PaymentEvent[]
  couponRedemptions            CouponRedemption[]

  @@index([isActive])
  @@index([activeMcp])
  competitors Competitor[]

  @@map("hotel_tenants")
}

model Competitor {
  id                  String      @id @default(uuid()) @db.Uuid
  hotelTenantId       String      @map("hotel_tenant_id") @db.Uuid
  locationKey         String      @map("location_key") @db.VarChar(120)
  externalKey         String      @map("external_key") @db.VarChar(120)
  name                String      @db.Text
  accommodationType   String?     @map("accommodation_type") @db.Text
  url                 String?     @db.Text
  rating              Float?
  reviewCount         Int?        @map("review_count")
  minPrice            Decimal?    @map("min_price") @db.Decimal(14, 2)
  maxPrice            Decimal?    @map("max_price") @db.Decimal(14, 2)
  latitude            Float?
  longitude           Float?
  image               String?     @db.Text
  mentions            Json        @default("[]")
  merchandisingLabels Json        @default("[]") @map("merchandising_labels")
  rawPayload          Json        @map("raw_payload")
  lastFetchedAt       DateTime    @map("last_fetched_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant         HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)

  @@unique([hotelTenantId, locationKey, externalKey])
  @@index([hotelTenantId, locationKey, name])
  @@map("competitors")
}


model Coupon {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique @db.VarChar(64)
  percentOff      Int                @map("percent_off")
  maxRedemptions  Int?               @map("max_redemptions")
  redemptionCount Int                @default(0) @map("redemption_count")
  expiresAt       DateTime?          @map("expires_at") @db.Timestamptz(3)
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  redemptions     CouponRedemption[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id                   String      @id @default(uuid()) @db.Uuid
  couponId             String      @map("coupon_id") @db.Uuid
  hotelTenantId        String      @unique @map("hotel_tenant_id") @db.Uuid
  originalAmount       Decimal     @map("original_amount") @db.Decimal(10, 2)
  discountedAmount     Decimal     @map("discounted_amount") @db.Decimal(10, 2)
  currencyCode         String      @default("EUR") @map("currency_code") @db.VarChar(3)
  paypalSubscriptionId String?     @map("paypal_subscription_id") @db.VarChar(128)
  redeemedAt           DateTime    @default(now()) @map("redeemed_at") @db.Timestamptz(3)
  coupon               Coupon      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  hotelTenant          HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)

  @@unique([couponId, hotelTenantId])
  @@index([hotelTenantId, redeemedAt])
  @@map("coupon_redemptions")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  hotelTenantId          String             @map("hotel_tenant_id") @db.Uuid
  provider               PaymentProvider    @default(PAYPAL)
  providerSubscriptionId String             @unique @map("provider_subscription_id") @db.VarChar(128)
  providerPlanId         String             @map("provider_plan_id") @db.VarChar(128)
  status                 SubscriptionStatus @default(APPROVAL_PENDING)
  payerEmail             String?            @map("payer_email") @db.VarChar(320)
  startedAt              DateTime?          @map("started_at") @db.Timestamptz(3)
  nextBillingAt          DateTime?          @map("next_billing_at") @db.Timestamptz(3)
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant            HotelTenant        @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)

  @@index([hotelTenantId, status])
  @@map("subscriptions")
}

model PaymentEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  provider              PaymentProvider @default(PAYPAL)
  providerEventId       String          @unique @map("provider_event_id") @db.VarChar(128)
  eventType             String          @map("event_type") @db.VarChar(160)
  providerTransactionId String?         @map("provider_transaction_id") @db.VarChar(128)
  amount                Decimal?        @db.Decimal(12, 2)
  currencyCode          String?         @map("currency_code") @db.VarChar(3)
  transactionAt         DateTime?       @map("transaction_at") @db.Timestamptz(3)
  hotelTenantId         String?         @map("hotel_tenant_id") @db.Uuid
  payload               Json
  processedAt           DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  hotelTenant           HotelTenant?    @relation(fields: [hotelTenantId], references: [id], onDelete: SetNull)

  @@index([hotelTenantId, createdAt])
  @@index([eventType, createdAt])
  @@index([transactionAt])
  @@index([providerTransactionId])
  @@map("payment_events")
}

model BillingConfiguration {
  id           String          @id @db.VarChar(32)
  provider     PaymentProvider @default(PAYPAL)
  environment  String          @default("sandbox") @db.VarChar(16)
  productId    String?         @map("product_id") @db.VarChar(128)
  planId       String?         @map("plan_id") @db.VarChar(128)
  productName  String          @default("QualityFriend Hotel Operations") @map("product_name") @db.VarChar(127)
  planName     String          @default("QualityFriend Monthly") @map("plan_name") @db.VarChar(127)
  currencyCode String          @default("EUR") @map("currency_code") @db.VarChar(3)
  monthlyPrice Decimal         @default(39.00) @map("monthly_price") @db.Decimal(10, 2)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("billing_configurations")
}

model User {
  id                     String        @id @default(uuid()) @db.Uuid
  hotelTenantId          String        @map("hotel_tenant_id") @db.Uuid
  mcpUserId              String?       @map("mcp_user_id") @db.VarChar(128)
  mcpUserPassword        String?       @map("mcp_user_password") @db.VarChar(255)
  firstName              String        @map("first_name") @db.VarChar(120)
  lastName               String        @map("last_name") @db.VarChar(120)
  email                  String        @unique @db.VarChar(320)
  passwordHash           String        @map("password_hash") @db.VarChar(255)
  phoneNumber            String?       @map("phone_number") @db.VarChar(40)
  language               HotelLanguage @default(EN) @map("language")
  role                   UserRole      @default(EMPLOYEE)
  departmentId           String?       @map("department_id") @db.Uuid
  isActive               Boolean       @default(true) @map("is_active")
  isDeleted              Boolean       @default(false) @map("is_deleted")
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(3)
  lastLoginAt            DateTime?     @map("last_login_at") @db.Timestamptz(3)
  lastSeenAt             DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  twoFactorEnabled       Boolean       @default(false) @map("two_factor_enabled")
  twoFactorSecret        String?       @map("two_factor_secret") @db.Text
  twoFactorRecoveryCodes Json?         @map("two_factor_recovery_codes")
  twoFactorEnabledAt     DateTime?     @map("two_factor_enabled_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant            HotelTenant   @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  departmentsCreated     Department[]  @relation("DepartmentCreatedBy")
  departmentsUpdated     Department[]  @relation("DepartmentUpdatedBy")
  teamsCreated           Team[]        @relation("TeamCreatedBy")
  teamsUpdated           Team[]        @relation("TeamUpdatedBy")
  auditLogs              AuditLog[]
  department             Department?   @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  chatMessagesSent       ChatMessage[] @relation("ChatMessageSender")
  chatMessagesReceived   ChatMessage[] @relation("ChatMessageRecipient")

  @@index([hotelTenantId])
  @@index([hotelTenantId, isActive])
  @@index([hotelTenantId, isDeleted])
  @@index([hotelTenantId, lastSeenAt])
  @@index([departmentId])
  @@index([mcpUserId])
  @@map("users")
}

enum ChatMessageType {
  TEXT
  DOCUMENT
  IMAGE
  VIDEO
  VOICE
}

model ChatMessage {
  id             String          @id @default(uuid()) @db.Uuid
  hotelTenantId  String          @map("hotel_tenant_id") @db.Uuid
  senderId       String          @map("sender_id") @db.Uuid
  recipientId    String          @map("recipient_id") @db.Uuid
  type           ChatMessageType @default(TEXT)
  text           String?         @db.Text
  attachmentPath String?         @map("attachment_path") @db.VarChar(2048)
  attachmentName String?         @map("attachment_name") @db.VarChar(255)
  attachmentMime String?         @map("attachment_mime") @db.VarChar(160)
  attachmentSize Int?            @map("attachment_size")
  readAt         DateTime?       @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  sender         User            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User            @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([hotelTenantId, senderId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@map("chat_messages")
}

model Department {
  id                        String                     @id @default(uuid()) @db.Uuid
  hotelTenantId             String                     @map("hotel_tenant_id") @db.Uuid
  mcpDepartmentId           String?                    @map("mcp_department_id") @db.VarChar(128)
  nameEn                    String                     @map("name_en") @db.VarChar(180)
  nameDe                    String                     @map("name_de") @db.VarChar(180)
  nameIt                    String                     @map("name_it") @db.VarChar(180)
  isActive                  Boolean                    @default(true) @map("is_active")
  isDeleted                 Boolean                    @default(false) @map("is_deleted")
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant               HotelTenant                @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  createdById               String?                    @map("created_by_id") @db.Uuid
  updatedById               String?                    @map("updated_by_id") @db.Uuid
  createdBy                 User?                      @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                 User?                      @relation("DepartmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  members                   User[]                     @relation("DepartmentMembers")
  rolePermissionDepartments RolePermissionDepartment[]

  @@unique([hotelTenantId, nameEn])
  @@index([hotelTenantId, isDeleted])
  @@index([hotelTenantId, isActive])
  @@index([mcpDepartmentId])
  @@index([createdById])
  @@index([updatedById])
  @@map("departments")
}

model Team {
  id            String      @id @default(uuid()) @db.Uuid
  hotelTenantId String      @map("hotel_tenant_id") @db.Uuid
  nameEn        String      @map("name_en") @db.VarChar(180)
  nameDe        String      @map("name_de") @db.VarChar(180)
  nameIt        String      @map("name_it") @db.VarChar(180)
  isActive      Boolean     @default(true) @map("is_active")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant   HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  createdById   String?     @map("created_by_id") @db.Uuid
  updatedById   String?     @map("updated_by_id") @db.Uuid
  createdBy     User?       @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?       @relation("TeamUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([hotelTenantId, nameEn])
  @@index([hotelTenantId, isDeleted])
  @@index([hotelTenantId, isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("teams")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  hotelTenantId String      @map("hotel_tenant_id") @db.Uuid
  actorId       String?     @map("actor_id") @db.Uuid
  action        String      @db.VarChar(40)
  entityType    String      @map("entity_type") @db.VarChar(80)
  entityId      String?     @map("entity_id") @db.Uuid
  changes       Json?
  description   Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  hotelTenant   HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([hotelTenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RoleModulePermission {
  id              String                     @id @default(uuid()) @db.Uuid
  hotelTenantId   String                     @map("hotel_tenant_id") @db.Uuid
  role            UserRole
  moduleKey       String                     @map("module_key") @db.VarChar(80)
  canView         Boolean                    @default(false) @map("can_view")
  canCreate       Boolean                    @default(false) @map("can_create")
  canUpdate       Boolean                    @default(false) @map("can_update")
  canChangeStatus Boolean                    @default(false) @map("can_change_status")
  canAssign       Boolean                    @default(false) @map("can_assign")
  canDelete       Boolean                    @default(false) @map("can_delete")
  scope           PermissionScope            @default(OWN)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant     HotelTenant                @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  departments     RolePermissionDepartment[]

  @@unique([hotelTenantId, role, moduleKey])
  @@index([hotelTenantId, role])
  @@map("role_module_permissions")
}

model RolePermissionDepartment {
  permissionId String               @map("permission_id") @db.Uuid
  departmentId String               @map("department_id") @db.Uuid
  permission   RoleModulePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([permissionId, departmentId])
  @@index([departmentId])
  @@map("role_permission_departments")
}

model RegistrationRateLimit {
  id           String   @id @default(uuid()) @db.Uuid
  keyHash      String   @map("key_hash") @db.VarChar(64)
  windowStart  DateTime @map("window_start") @db.Timestamptz(3)
  requestCount Int      @default(1) @map("request_count")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyHash, windowStart])
  @@index([expiresAt])
  @@map("registration_rate_limits")
}
