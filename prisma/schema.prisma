// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Step one: XML/stay foundation. Import matching must be verified against source XML.

enum ImportRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ReservationStatus {
  UNKNOWN
  RESERVED
  OCCUPIED
  DEPARTED
  CANCELLED
  NO_SHOW
}

enum RoomCleanliness {
  UNKNOWN
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

enum HousekeepingCleaningType {
  REGULAR
  EXPRESS
  DEPARTURE
}

enum HousekeepingAssignmentOrigin {
  TODAY_ONLY
  PERMANENT
}

enum HousekeepingChecklistType {
  ROOM
  ARRIVAL
}

model ExtraJob {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  descriptionEn String @default("") @map("description_en") @db.Text
  descriptionDe String @default("") @map("description_de") @db.Text
  descriptionIt String @default("") @map("description_it") @db.Text
  minutes Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scheduleAssignmentRecords HousekeepingExtraJobAssignment[]
  permanentScheduleAssignmentRecords HousekeepingPermanentExtraJobAssignment[]

  @@index([hotelTenantId])
  @@unique([hotelTenantId, id])
  @@map("extra_jobs")
}

model Floor {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  code String @db.VarChar(40)
  nameEn String @map("name_en") @db.VarChar(180)
  nameDe String? @map("name_de") @db.VarChar(180)
  nameIt String? @map("name_it") @db.VarChar(180)
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomRecords Room[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, code])

  @@map("floors")
}

model RoomCategory {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  nameEn String @map("name_en") @db.VarChar(180)
  nameDe String? @map("name_de") @db.VarChar(180)
  nameIt String? @map("name_it") @db.VarChar(180)
  expressMinutes Int? @map("express_minutes")
  normalMinutes Int? @map("normal_minutes")
  departureMinutes Int? @map("departure_minutes")
  finalMinutes Int? @map("final_minutes")
  cleaningFrequency String? @map("cleaning_frequency") @db.VarChar(30)
  cleaningWeekdays Int[] @default([]) @map("cleaning_weekdays")
  linenFrequency String? @map("linen_frequency") @db.VarChar(30)
  linenWeekdays Int[] @default([]) @map("linen_weekdays")
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomRecords Room[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, nameEn])

  @@map("room_categories")
}

model Room {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  number String @db.VarChar(40)
  nameEn String? @map("name_en") @db.VarChar(180)
  nameDe String? @map("name_de") @db.VarChar(180)
  nameIt String? @map("name_it") @db.VarChar(180)
  floorId String? @map("floor_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  floor Floor? @relation(fields: [hotelTenantId, floorId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  category RoomCategory? @relation(fields: [hotelTenantId, categoryId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationRoomStayRecords ReservationRoomStay[]
  roomOperationalStateRecords RoomOperationalState[]
  checklistTemplate RoomChecklistTemplate?
  housekeepingChecklistCompletionRecords HousekeepingChecklistCompletion[]
  housekeepingScheduleAssignmentRecords HousekeepingRoomAssignment[]
  housekeepingPermanentAssignmentRecords HousekeepingPermanentRoomAssignment[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, number])
  @@index([hotelTenantId, floorId])
  @@index([hotelTenantId, categoryId])
  @@map("rooms")
}

model RoomChecklistTemplate {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomId String @unique @map("room_id") @db.Uuid
  roomChecksEn Json @map("room_checks_en") @db.JsonB
  roomChecksDe Json @map("room_checks_de") @db.JsonB
  roomChecksIt Json @map("room_checks_it") @db.JsonB
  arrivalChecksEn Json @map("arrival_checks_en") @db.JsonB
  arrivalChecksDe Json @map("arrival_checks_de") @db.JsonB
  arrivalChecksIt Json @map("arrival_checks_it") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@map("room_checklist_templates")
}

model HousekeepingChecklistCompletion {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  workDate DateTime @map("work_date") @db.Date
  checklistType HousekeepingChecklistType @map("checklist_type")
  checkIndex Int @map("check_index")
  checkTextEn String @map("check_text_en") @db.Text
  checkTextDe String @map("check_text_de") @db.Text
  checkTextIt String @map("check_text_it") @db.Text
  checkedById String @map("checked_by_id") @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  checkedBy User @relation("HousekeepingChecklistChecker", fields: [hotelTenantId, checkedById], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, workDate, roomId, checklistType, checkIndex])
  @@index([hotelTenantId, roomId, workDate])
  @@map("housekeeping_checklist_completions")
}

model HotelImportSource {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  provider String @default("ASA_XML") @db.VarChar(80)
  sourceKey String @map("source_key") @db.VarChar(180)
  lastSuccessfulAt DateTime? @map("last_successful_at") @db.Timestamptz(3)
  isActive Boolean @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  importRunRecords ImportRun[]
  reservationRecords Reservation[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, provider, sourceKey])

  @@map("hotel_import_sources")
}

model ImportRun {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  status ImportRunStatus @default(RUNNING)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  checksum String? @db.VarChar(64)
  recordsRead Int @default(0) @map("records_read")
  recordsCreated Int @default(0) @map("records_created")
  recordsUpdated Int @default(0) @map("records_updated")
  recordsRejected Int @default(0) @map("records_rejected")
  errorSummary String? @map("error_summary") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source HotelImportSource @relation(fields: [hotelTenantId, sourceId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@index([hotelTenantId, sourceId, startedAt])
  @@map("import_runs")
}

model Reservation {
  sourcePresent Boolean @default(true) @map("source_present")
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  sourceId String? @map("source_id") @db.Uuid
  externalId String? @map("external_id") @db.VarChar(255)
  sourceStatus String? @map("source_status") @db.VarChar(80)
  status ReservationStatus @default(UNKNOWN)
  bookingGroup String? @map("booking_group") @db.VarChar(255)
  offer String? @db.Text
  board String? @db.VarChar(120)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source HotelImportSource? @relation(fields: [hotelTenantId, sourceId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationRoomStayRecords ReservationRoomStay[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, sourceId, externalId])
  @@index([hotelTenantId, status])
  @@map("reservations")
}

model ReservationRoomStay {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  sourceSegmentId String? @map("source_segment_id") @db.VarChar(255)
  arrivalDate DateTime @map("arrival_date") @db.Date
  departureDate DateTime @map("departure_date") @db.Date
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt DateTime? @map("checked_out_at") @db.Timestamptz(3)
  sourceStatus String? @map("source_status") @db.VarChar(80)
  adultCount Int? @map("adult_count")
  childCount Int? @map("child_count")
  childK1Count Int? @map("child_k1_count")
  childK2Count Int? @map("child_k2_count")
  childK3Count Int? @map("child_k3_count")
  serviceRemarks String? @map("service_remarks") @db.Text
  sourceFromRoomNumber String? @map("source_from_room_number") @db.VarChar(40)
  sourceToRoomNumber String? @map("source_to_room_number") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation Reservation @relation(fields: [hotelTenantId, reservationId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationGuestRecords ReservationGuest[]
  housekeepingRoomAssignmentRecords HousekeepingRoomAssignment[]

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, reservationId, sourceSegmentId])
  @@index([hotelTenantId, arrivalDate])
  @@index([hotelTenantId, departureDate])
  @@index([hotelTenantId, roomId, arrivalDate])
  @@map("reservation_room_stays")
}

model ReservationGuest {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomStayId String @map("room_stay_id") @db.Uuid
  sourceGuestId String? @map("source_guest_id") @db.VarChar(255)
  name String @db.VarChar(255)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  language String? @db.VarChar(40)
  vip Boolean?
  previousStayCount Int? @map("previous_stay_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomStay ReservationRoomStay @relation(fields: [hotelTenantId, roomStayId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, roomStayId, sourceGuestId])

  @@map("reservation_guests")
}

model RoomOperationalState {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  cleanliness RoomCleanliness @default(UNKNOWN)
  breakfastInRoom Boolean @default(false) @map("breakfast_in_room")
  doNotDisturb Boolean @default(false) @map("do_not_disturb")
  noService Boolean @default(false) @map("no_service")
  doNotDisturbUntil DateTime? @map("do_not_disturb_until") @db.Timestamptz(3)
  noServiceUntil DateTime? @map("no_service_until") @db.Timestamptz(3)
  isExpress Boolean @default(false) @map("is_express")
  linenChange Boolean @default(false) @map("linen_change")
  expressDeadline DateTime? @map("express_deadline") @db.Timestamptz(3)
  lastCleanedAt DateTime? @map("last_cleaned_at") @db.Timestamptz(3)
  lastInspectedAt DateTime? @map("last_inspected_at") @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, id])
  @@unique([hotelTenantId, roomId])
  @@index([hotelTenantId, cleanliness])
  @@map("room_operational_states")
}

model HousekeepingRoomAssignment {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  workDate DateTime @map("work_date") @db.Date
  roomId String @map("room_id") @db.Uuid
  assignedToId String? @map("assigned_to_id") @db.Uuid
  reservationStayId String? @map("reservation_stay_id") @db.Uuid
  cleaningType HousekeepingCleaningType @default(REGULAR) @map("cleaning_type")
  assignmentOrigin HousekeepingAssignmentOrigin @default(TODAY_ONLY) @map("assignment_origin")
  plannedMinutes Int @map("planned_minutes")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedTo User? @relation("HousekeepingRoomAssignee", fields: [hotelTenantId, assignedToId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reservationStay ReservationRoomStay? @relation(fields: [hotelTenantId, reservationStayId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, workDate, roomId])
  @@index([hotelTenantId, workDate, assignedToId])
  @@map("housekeeping_room_assignments")
}

model HousekeepingExtraJobAssignment {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  workDate DateTime @map("work_date") @db.Date
  extraJobId String @map("extra_job_id") @db.Uuid
  assignedToId String @map("assigned_to_id") @db.Uuid
  plannedMinutes Int @map("planned_minutes")
  assignmentOrigin HousekeepingAssignmentOrigin @default(TODAY_ONLY) @map("assignment_origin")
  descriptionSnapshot String @default("") @map("description_snapshot") @db.Text
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  extraJob ExtraJob @relation(fields: [hotelTenantId, extraJobId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedTo User @relation("HousekeepingExtraJobAssignee", fields: [hotelTenantId, assignedToId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([hotelTenantId, workDate, extraJobId, assignedToId])
  @@index([hotelTenantId, workDate, assignedToId])
  @@map("housekeeping_extra_job_assignments")
}

model HousekeepingPermanentRoomAssignment {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  assignedToId String @map("assigned_to_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "hk_perm_room_tenant_fkey")
  room Room @relation(fields: [hotelTenantId, roomId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "hk_perm_room_room_fkey")
  assignedTo User @relation("HousekeepingPermanentRoomAssignee", fields: [hotelTenantId, assignedToId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "hk_perm_room_user_fkey")
  @@unique([hotelTenantId, roomId])
  @@index([hotelTenantId, assignedToId])
  @@map("housekeeping_permanent_room_assignments")
}

model HousekeepingPermanentExtraJobAssignment {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  extraJobId String @map("extra_job_id") @db.Uuid
  assignedToId String @map("assigned_to_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "hk_perm_extra_tenant_fkey")
  extraJob ExtraJob @relation(fields: [hotelTenantId, extraJobId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "hk_perm_extra_job_fkey")
  assignedTo User @relation("HousekeepingPermanentExtraJobAssignee", fields: [hotelTenantId, assignedToId], references: [hotelTenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "hk_perm_extra_user_fkey")
  @@unique([hotelTenantId, extraJobId, assignedToId])
  @@index([hotelTenantId, assignedToId])
  @@map("housekeeping_permanent_extra_job_assignments")
}

model HousekeepingDailyRun {
  id String @id @default(uuid()) @db.Uuid
  hotelTenantId String @map("hotel_tenant_id") @db.Uuid
  workDate DateTime @map("work_date") @db.Date
  status ImportRunStatus @default(RUNNING)
  roomsGenerated Int @default(0) @map("rooms_generated")
  extrasGenerated Int @default(0) @map("extras_generated")
  errorSummary String? @map("error_summary") @db.Text
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  hotelTenant HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([hotelTenantId, workDate])
  @@map("housekeeping_daily_runs")
}


model SuperAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("super_admins")
}

enum HotelLanguage {
  EN
  DE
  IT
}

enum UserRole {
  EMPLOYEE
  TEAM_LEAD
  MANAGEMENT
  ADMIN
}

enum PermissionScope {
  OWN
  DEPARTMENT
  ALL
}

enum SubscriptionStatus {
  PENDING
  APPROVAL_PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  COMPED
}

enum PaymentProvider {
  PAYPAL
}

model HotelTenant {
  notifications Notification[]
  asaXmlName String? @map("asa_xml_name") @db.VarChar(255)
  // Configure before resolving hotel-local operational dates; no guessed default.
  timeZone String? @map("time_zone") @db.VarChar(80)
  floorRecords Floor[]
  roomCategoryRecords RoomCategory[]
  roomRecords Room[]
  hotelImportSourceRecords HotelImportSource[]
  importRunRecords ImportRun[]
  reservationRecords Reservation[]
  reservationRoomStayRecords ReservationRoomStay[]
  reservationGuestRecords ReservationGuest[]
  roomOperationalStateRecords RoomOperationalState[]
  roomChecklistTemplateRecords RoomChecklistTemplate[]
  housekeepingRoomAssignmentRecords HousekeepingRoomAssignment[]
  housekeepingExtraJobAssignmentRecords HousekeepingExtraJobAssignment[]
  housekeepingChecklistCompletionRecords HousekeepingChecklistCompletion[]
  housekeepingPermanentRoomAssignmentRecords HousekeepingPermanentRoomAssignment[]
  housekeepingPermanentExtraJobAssignmentRecords HousekeepingPermanentExtraJobAssignment[]
  housekeepingDailyRunRecords HousekeepingDailyRun[]
  id                           String                 @id @default(uuid()) @db.Uuid
