// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("super_admins")
}

enum HotelLanguage {
  EN
  DE
  IT
}

enum UserRole {
  EMPLOYEE
  TEAM_LEAD
  MANAGEMENT
  ADMIN
}

enum PermissionScope {
  OWN
  DEPARTMENT
  ALL
}

enum SubscriptionStatus {
  PENDING
  APPROVAL_PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  PAYPAL
}

model HotelTenant {
  id               String        @id @default(uuid()) @db.Uuid
  hotelNameEn      String        @map("hotel_name_en") @db.VarChar(180)
  hotelNameDe      String        @map("hotel_name_de") @db.VarChar(180)
  hotelNameIt      String        @map("hotel_name_it") @db.VarChar(180)
  email            String        @db.VarChar(320)
  logoUrl          String?       @map("logo_url") @db.VarChar(2048)
  hotelLanguage    HotelLanguage @default(EN) @map("hotel_language")
  isActive         Boolean       @default(true) @map("is_active")
  dataProtectionEn String?       @map("data_protection_en") @db.Text
  dataProtectionDe String?       @map("data_protection_de") @db.Text
  dataProtectionIt String?       @map("data_protection_it") @db.Text
  privacyPolicyEn  String?       @map("privacy_policy_en") @db.Text
  privacyPolicyDe  String?       @map("privacy_policy_de") @db.Text
  privacyPolicyIt  String?       @map("privacy_policy_it") @db.Text
  companyName      String        @map("company_name") @db.VarChar(180)
  streetAddress    String        @map("street_address") @db.VarChar(255)
  postalCode       String        @map("postal_code") @db.VarChar(32)
  city             String        @db.VarChar(120)
  country          String        @db.VarChar(120)
  contactPerson    String        @map("contact_person") @db.VarChar(180)
  phoneNumber      String?       @map("phone_number") @db.VarChar(40)
  vatId            String?       @map("vat_id") @db.VarChar(64)
  tripadvisorId    String?       @map("tripadvisor_id") @db.VarChar(120)
  subscriptionStatus SubscriptionStatus @default(PENDING) @map("subscription_status")
  paypalSubscriptionId String?   @unique @map("paypal_subscription_id") @db.VarChar(128)
  paypalPlanId     String?       @map("paypal_plan_id") @db.VarChar(128)
  subscriptionStartedAt DateTime? @map("subscription_started_at") @db.Timestamptz(3)
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end") @db.Timestamptz(3)
  subscriptionCancelledAt DateTime? @map("subscription_cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  users            User[]
  departments      Department[]
  teams            Team[]
  auditLogs        AuditLog[]
  rolePermissions  RoleModulePermission[]
  subscriptions    Subscription[]
  paymentEvents    PaymentEvent[]

  @@index([isActive])
  @@map("hotel_tenants")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  hotelTenantId          String             @map("hotel_tenant_id") @db.Uuid
  provider               PaymentProvider    @default(PAYPAL)
  providerSubscriptionId String             @unique @map("provider_subscription_id") @db.VarChar(128)
  providerPlanId         String             @map("provider_plan_id") @db.VarChar(128)
  status                 SubscriptionStatus @default(APPROVAL_PENDING)
  payerEmail             String?            @map("payer_email") @db.VarChar(320)
  startedAt              DateTime?          @map("started_at") @db.Timestamptz(3)
  nextBillingAt          DateTime?          @map("next_billing_at") @db.Timestamptz(3)
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant            HotelTenant        @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)

  @@index([hotelTenantId, status])
  @@map("subscriptions")
}

model PaymentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider @default(PAYPAL)
  providerEventId String          @unique @map("provider_event_id") @db.VarChar(128)
  eventType       String          @map("event_type") @db.VarChar(160)
  providerTransactionId String?   @map("provider_transaction_id") @db.VarChar(128)
  amount          Decimal?        @db.Decimal(12, 2)
  currencyCode    String?         @map("currency_code") @db.VarChar(3)
  transactionAt   DateTime?       @map("transaction_at") @db.Timestamptz(3)
  hotelTenantId   String?         @map("hotel_tenant_id") @db.Uuid
  payload         Json
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  hotelTenant     HotelTenant?    @relation(fields: [hotelTenantId], references: [id], onDelete: SetNull)

  @@index([hotelTenantId, createdAt])
  @@index([eventType, createdAt])
  @@index([transactionAt])
  @@index([providerTransactionId])
  @@map("payment_events")
}

model BillingConfiguration {
  id                String   @id @db.VarChar(32)
  provider          PaymentProvider @default(PAYPAL)
  environment       String   @default("sandbox") @db.VarChar(16)
  productId         String?  @map("product_id") @db.VarChar(128)
  planId            String?  @map("plan_id") @db.VarChar(128)
  productName       String   @default("QualityFriend Hotel Operations") @map("product_name") @db.VarChar(127)
  planName          String   @default("QualityFriend Monthly") @map("plan_name") @db.VarChar(127)
  currencyCode      String   @default("EUR") @map("currency_code") @db.VarChar(3)
  monthlyPrice      Decimal  @default(39.00) @map("monthly_price") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("billing_configurations")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  hotelTenantId String      @map("hotel_tenant_id") @db.Uuid
  firstName     String      @map("first_name") @db.VarChar(120)
  lastName      String      @map("last_name") @db.VarChar(120)
  email         String      @unique @db.VarChar(320)
  passwordHash  String      @map("password_hash") @db.VarChar(255)
  phoneNumber   String?     @map("phone_number") @db.VarChar(40)
  language      HotelLanguage @default(EN) @map("language")
  role          UserRole    @default(EMPLOYEE)
  departmentId  String?     @map("department_id") @db.Uuid
  isActive      Boolean     @default(true) @map("is_active")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  lastLoginAt   DateTime?   @map("last_login_at") @db.Timestamptz(3)
  lastSeenAt    DateTime?   @map("last_seen_at") @db.Timestamptz(3)
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?  @map("two_factor_secret") @db.Text
  twoFactorRecoveryCodes Json? @map("two_factor_recovery_codes")
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant   HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  departmentsCreated Department[] @relation("DepartmentCreatedBy")
  departmentsUpdated Department[] @relation("DepartmentUpdatedBy")
  teamsCreated       Team[]       @relation("TeamCreatedBy")
  teamsUpdated       Team[]       @relation("TeamUpdatedBy")
  auditLogs          AuditLog[]
  department         Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  chatMessagesSent     ChatMessage[] @relation("ChatMessageSender")
  chatMessagesReceived ChatMessage[] @relation("ChatMessageRecipient")

  @@index([hotelTenantId])
  @@index([hotelTenantId, isActive])
  @@index([hotelTenantId, isDeleted])
  @@index([hotelTenantId, lastSeenAt])
  @@index([departmentId])
  @@map("users")
}

enum ChatMessageType {
  TEXT
  DOCUMENT
  IMAGE
  VIDEO
  VOICE
}

model ChatMessage {
  id             String          @id @default(uuid()) @db.Uuid
  hotelTenantId  String          @map("hotel_tenant_id") @db.Uuid
  senderId       String          @map("sender_id") @db.Uuid
  recipientId    String          @map("recipient_id") @db.Uuid
  type           ChatMessageType @default(TEXT)
  text           String?         @db.Text
  attachmentPath String?         @map("attachment_path") @db.VarChar(2048)
  attachmentName String?         @map("attachment_name") @db.VarChar(255)
  attachmentMime String?         @map("attachment_mime") @db.VarChar(160)
  attachmentSize Int?            @map("attachment_size")
  readAt         DateTime?       @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  sender         User            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User            @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([hotelTenantId, senderId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@map("chat_messages")
}

model Department {
  id            String      @id @default(uuid()) @db.Uuid
  hotelTenantId String      @map("hotel_tenant_id") @db.Uuid
  nameEn        String      @map("name_en") @db.VarChar(180)
  nameDe        String      @map("name_de") @db.VarChar(180)
  nameIt        String      @map("name_it") @db.VarChar(180)
  isActive      Boolean     @default(true) @map("is_active")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant   HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  createdById   String?     @map("created_by_id") @db.Uuid
  updatedById   String?     @map("updated_by_id") @db.Uuid
  createdBy     User?       @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?       @relation("DepartmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  members       User[]      @relation("DepartmentMembers")
  rolePermissionDepartments RolePermissionDepartment[]

  @@unique([hotelTenantId, nameEn])
  @@index([hotelTenantId, isDeleted])
  @@index([hotelTenantId, isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("departments")
}

model Team {
  id            String      @id @default(uuid()) @db.Uuid
  hotelTenantId String      @map("hotel_tenant_id") @db.Uuid
  nameEn        String      @map("name_en") @db.VarChar(180)
  nameDe        String      @map("name_de") @db.VarChar(180)
  nameIt        String      @map("name_it") @db.VarChar(180)
  isActive      Boolean     @default(true) @map("is_active")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant   HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  createdById   String?     @map("created_by_id") @db.Uuid
  updatedById   String?     @map("updated_by_id") @db.Uuid
  createdBy     User?       @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?       @relation("TeamUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([hotelTenantId, nameEn])
  @@index([hotelTenantId, isDeleted])
  @@index([hotelTenantId, isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("teams")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  hotelTenantId String      @map("hotel_tenant_id") @db.Uuid
  actorId       String?     @map("actor_id") @db.Uuid
  action        String      @db.VarChar(40)
  entityType    String      @map("entity_type") @db.VarChar(80)
  entityId      String?     @map("entity_id") @db.Uuid
  changes       Json?
  description   Json?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  hotelTenant   HotelTenant @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([hotelTenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RoleModulePermission {
  id              String          @id @default(uuid()) @db.Uuid
  hotelTenantId   String          @map("hotel_tenant_id") @db.Uuid
  role            UserRole
  moduleKey       String          @map("module_key") @db.VarChar(80)
  canView         Boolean         @default(false) @map("can_view")
  canCreate       Boolean         @default(false) @map("can_create")
  canUpdate       Boolean         @default(false) @map("can_update")
  canChangeStatus Boolean         @default(false) @map("can_change_status")
  canAssign       Boolean         @default(false) @map("can_assign")
  canDelete       Boolean         @default(false) @map("can_delete")
  scope           PermissionScope @default(OWN)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  hotelTenant     HotelTenant     @relation(fields: [hotelTenantId], references: [id], onDelete: Cascade)
  departments     RolePermissionDepartment[]

  @@unique([hotelTenantId, role, moduleKey])
  @@index([hotelTenantId, role])
  @@map("role_module_permissions")
}

model RolePermissionDepartment {
  permissionId String               @map("permission_id") @db.Uuid
  departmentId String               @map("department_id") @db.Uuid
  permission   RoleModulePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([permissionId, departmentId])
  @@index([departmentId])
  @@map("role_permission_departments")
}

model RegistrationRateLimit {
  id          String   @id @default(uuid()) @db.Uuid
  keyHash     String   @map("key_hash") @db.VarChar(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  requestCount Int     @default(1) @map("request_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyHash, windowStart])
  @@index([expiresAt])
  @@map("registration_rate_limits")
}
