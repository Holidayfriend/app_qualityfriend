# Copy this file to .env before starting the local Docker stack.
# Keep the real .env file private; Next.js already excludes it from Git.

APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5433
POSTGRES_DB=qualityfriend_dev
POSTGRES_USER=qualityfriend
POSTGRES_PASSWORD=replace_with_a_local_password
AUTH_SECRET=replace_with_a_long_random_session_secret
TOTP_ENCRYPTION_KEY=replace_with_a_different_long_random_encryption_secret
ADMIN_AUTH_SECRET=replace_with_a_different_long_random_admin_session_secret

# PayPal Subscriptions. Sandbox and Live use different credentials and IDs.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_PRODUCT_ID=replace_with_paypal_product_id
PAYPAL_PLAN_ID=replace_with_paypal_plan_id
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace_with_same_paypal_client_id

# Used only by the explicit Prisma seed command. Never commit real credentials.
SUPER_ADMIN_NAME=QualityFriend Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_at_least_12_characters
