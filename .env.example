# Copy this file to .env before starting the local Docker stack.
# Keep the real .env file private; Next.js already excludes it from Git.

APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5433
POSTGRES_DB=qualityfriend_dev
POSTGRES_USER=qualityfriend
POSTGRES_PASSWORD=replace_with_a_local_password
AUTH_SECRET=replace_with_a_long_random_session_secret
ADMIN_AUTH_SECRET=replace_with_a_different_long_random_admin_session_secret

# Used only by the explicit Prisma seed command. Never commit real credentials.
SUPER_ADMIN_NAME=QualityFriend Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_at_least_12_characters
